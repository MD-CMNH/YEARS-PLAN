{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "years-plan-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/config.js"]
  },
  // Public (non-secret) Supabase settings. The anon key is safe to expose:
  // all tables are protected by Row Level Security (see supabase/migrations).
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": ""
  }
}
